{
  "name": "screen-translator-windows",
  "version": "1.0.0",
  "description": "Applicazione Windows per cattura schermo, OCR e traduzione EN→IT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --win --x64",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "screen-capture",
    "ocr",
    "translation",
    "windows"
  ],
  "author": "Screen Translator",
  "license": "MIT",
  "dependencies": {
    "electron-screenshot-service": "^1.0.1",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^5.0.4",
    "translate-google": "^1.5.0",
    "@vitalets/google-translate-api": "^9.2.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^3.2.0"
  },
  "build": {
    "appId": "com.screentranslator.app",
    "productName": "Screen Translator",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/tesseract.js-core",
        "to": "tesseract.js-core"
      }
    ]
  }
}
